# ------------------------------------------------------------------
# Souq API - environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on (Railway injects PORT automatically).
PORT=4000

# PostgreSQL connection string.
#   Local:      postgres://USER:PASSWORD@localhost:5432/souq_dev
#   Hosted:     paste the connection string from your provider (Railway, Supabase, Neon, ...).
DATABASE_URL=

# Require SSL for the database connection. `require` is the default in
# production; use `disable` for a plain local PostgreSQL.
PGSSL=disable

# Secret used to sign JWTs. Use a long random string (>= 32 chars in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime (zeit/ms format: 1h, 1d, 7d, ...).
JWT_EXPIRES_IN=1d

# bcrypt cost factor (4-15). 12 is a good production default.
BCRYPT_SALT_ROUNDS=12

# Log format: dev | combined | common | short | tiny
LOG_LEVEL=dev

# Optional connection-pool tuning.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Development seed credentials (LOCAL DEVELOPMENT ONLY).
# Used by `npm run seed`; leave blank in production.
# ------------------------------------------------------------------
SEED_ADMIN_NAME=Souq Admin
SEED_ADMIN_EMAIL=admin@souq.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SELLER_NAME=Sample Seller
SEED_SELLER_EMAIL=seller@souq.local
SEED_SELLER_PASSWORD=Seller@12345
SEED_CUSTOMER_NAME=Sample Customer
SEED_CUSTOMER_EMAIL=customer@souq.local
SEED_CUSTOMER_PASSWORD=Customer@12345
